<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tvHomeRoot"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cochi_tv_dark_background"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/tvHomeSidebar"
        android:layout_width="184dp"
        android:layout_height="match_parent"
        android:background="@drawable/tv_sidebar_dark"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:layout_marginStart="14dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="14dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBrandText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CO-CHI"
                android:textColor="@color/cochi_accent_2"
                android:textSize="25sp"
                android:textStyle="bold"
                android:shadowColor="#AA19CFFF"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="7" />

            <TextView
                android:id="@+id/expirationDaysBadge"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/tv_days_badge"
                android:drawableTop="@drawable/ic_cochi_calendar"
                android:drawablePadding="-4dp"
                android:gravity="center"
                android:paddingTop="4dp"
                android:text="13"
                android:textColor="@color/cochi_text"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/welcomeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Cliente"
            android:textColor="@color/cochi_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/accountStatusTitle"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="CUENTA ACTIVA"
            android:textColor="@color/cochi_accent_2"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/accountStatus"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:text="vence en 30 días"
            android:textColor="@color/cochi_muted"
            android:textSize="11sp" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/tvNavHome"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:focusable="true"
            android:gravity="start|center_vertical"
            android:nextFocusRight="@id/heroPlayButton"
            android:text="Inicio"
            android:textAllCaps="false"
            android:textColor="@color/cochi_text"
            android:textSize="15sp"
            app:backgroundTint="@color/cochi_tv_surface_focus"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_cochi_home"
            app:iconSize="18dp"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@color/cochi_accent_2"
            app:strokeColor="@color/cochi_accent"
            app:strokeWidth="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tvNavTv1"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="4dp"
            android:focusable="true"
            android:gravity="start|center_vertical"
            android:text="TV 1"
            android:textAllCaps="false"
            android:textColor="@color/cochi_text"
            android:textSize="14sp"
            app:backgroundTint="@color/cochi_tv_surface_2"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_cochi_tv"
            app:iconSize="18dp"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@color/cochi_accent_2"
            app:strokeColor="@color/cochi_tv_border_soft"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tvNavTv2"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="4dp"
            android:focusable="true"
            android:gravity="start|center_vertical"
            android:text="TV 2"
            android:textAllCaps="false"
            android:textColor="@color/cochi_text"
            android:textSize="14sp"
            app:backgroundTint="@color/cochi_tv_surface_2"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_cochi_monitor"
            app:iconSize="18dp"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@color/cochi_accent_2"
            app:strokeColor="@color/cochi_tv_border_soft"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tvNavMovies"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="4dp"
            android:focusable="true"
            android:gravity="start|center_vertical"
            android:text="Películas"
            android:textAllCaps="false"
            android:textColor="@color/cochi_text"
            android:textSize="14sp"
            app:backgroundTint="@color/cochi_tv_surface_2"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_cochi_movies"
            app:iconSize="18dp"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@color/cochi_accent_2"
            app:strokeColor="@color/cochi_tv_border_soft"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tvNavSeries"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="4dp"
            android:focusable="true"
            android:gravity="start|center_vertical"
            android:text="Series"
            android:textAllCaps="false"
            android:textColor="@color/cochi_text"
            android:textSize="14sp"
            app:backgroundTint="@color/cochi_tv_surface_2"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_cochi_series"
            app:iconSize="18dp"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@color/cochi_accent_2"
            app:strokeColor="@color/cochi_tv_border_soft"
            app:strokeWidth="1dp" />



        <com.google.android.material.button.MaterialButton
            android:id="@+id/tvNavRefresh"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="4dp"
            android:focusable="true"
            android:gravity="start|center_vertical"
            android:text="Actualizar"
            android:textAllCaps="false"
            android:textColor="@color/cochi_text"
            android:textSize="13sp"
            app:backgroundTint="@color/cochi_tv_surface_2"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_cochi_refresh"
            app:iconSize="18dp"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@color/cochi_accent_2"
            app:strokeColor="@color/cochi_tv_border_soft"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tvNavAdult"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="4dp"
            android:focusable="true"
            android:gravity="start|center_vertical"
            android:text="Adultos"
            android:textAllCaps="false"
            android:textColor="@color/cochi_text"
            android:textSize="14sp"
            app:backgroundTint="@color/cochi_tv_surface_2"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_cochi_lock"
            app:iconSize="18dp"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@color/cochi_accent_2"
            app:strokeColor="@color/cochi_tv_border_soft"
            app:strokeWidth="1dp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logoutButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp"
            android:focusable="true"
            android:gravity="center"
            android:text="Desvincular"
            android:textAllCaps="false"
            android:textColor="@color/cochi_muted_strong"
            android:textSize="11sp"
            app:backgroundTint="@color/cochi_tv_surface_2"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_cochi_unlink"
            app:iconSize="18dp"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/cochi_accent_2"
            app:strokeColor="@color/cochi_tv_border_soft"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/tvHomeScroll"
        android:layout_width="0dp"
        android:background="@color/cochi_tv_bg"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
                android:paddingBottom="56dp"
                android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="22dp"
            android:paddingBottom="28dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="340dp"
                android:focusable="false"
                app:cardBackgroundColor="@color/cochi_tv_surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/cochi_tv_border_soft"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/heroImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Contenido destacado"
                        android:scaleType="centerCrop"
                        android:src="@drawable/cochi_tv_banner" />

                    <androidx.media3.ui.PlayerView
                        android:id="@+id/heroVideo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone"
                        app:resize_mode="zoom"
                        app:use_controller="false" />

                    <WebView
                        android:id="@+id/heroYoutube"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/black"
                        android:focusable="false"
                        android:visibility="gone" />

                    <View
                        android:id="@+id/heroScrim"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/tv_hero_scrim" />

                    <LinearLayout
                        android:layout_width="620dp"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="30dp"
                        android:paddingTop="18dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="18dp">

                        <TextView
                            android:id="@+id/heroEyebrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CO-CHI"
                            android:textColor="@color/cochi_accent_2"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/heroTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Tu entretenimiento"
                            android:textColor="@color/cochi_text"
                            android:textSize="33sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/heroDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="TV, películas y series en un solo lugar."
                            android:textColor="@color/cochi_muted_strong"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/heroMeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="CO-CHI TV"
                            android:textColor="@color/cochi_muted"
                            android:textSize="11sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/heroPlayButton"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:focusable="true"
                                android:text="Reproducir"
                                android:textAllCaps="false"
                                android:textColor="@color/cochi_text"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:backgroundTint="@color/cochi_blue_button"
                                app:cornerRadius="13dp"
                                app:icon="@android:drawable/ic_media_play"
                                app:iconGravity="textStart"
                                app:iconPadding="8dp"
                                app:iconTint="@color/cochi_text"
                                app:strokeColor="@color/cochi_accent_2"
                                app:strokeWidth="1dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/heroExploreButton"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:layout_marginStart="10dp"
                                android:focusable="true"
                                android:text="Explorar"
                                android:textAllCaps="false"
                                android:textColor="@color/cochi_text"
                                android:textSize="13sp"
                                app:backgroundTint="@color/cochi_tv_surface_2"
                                app:cornerRadius="13dp"
                                app:strokeColor="@color/cochi_tv_border"
                                app:strokeWidth="1dp" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <ProgressBar
                android:id="@+id/tvHomeLoading"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:indeterminateTint="@color/cochi_accent" />

            <TextView
                android:id="@+id/tvHomeStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/cochi_muted"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/homeContinueSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Continuar viendo"
                    android:textColor="@color/cochi_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/homeContinueRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="168dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingStart="2dp"
                    android:paddingEnd="12dp" />
            </LinearLayout>

            <!-- v0.23.72: contenedores de compatibilidad ocultos.
                 Mantienen los IDs que MainActivity usa internamente sin volver a
                 mostrar las grillas duplicadas de TV/Películas/Series en Inicio. -->
            <LinearLayout
                android:id="@+id/homeLiveSection"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/homeLiveRecycler"
                    android:layout_width="0dp"
                    android:layout_height="0dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/homeMoviesSection"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/homeMoviesRecycler"
                    android:layout_width="0dp"
                    android:layout_height="0dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/homeSeriesSection"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/homeSeriesRecycler"
                    android:layout_width="0dp"
                    android:layout_height="0dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
