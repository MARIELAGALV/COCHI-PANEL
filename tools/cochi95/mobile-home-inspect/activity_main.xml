<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cochi_neon_background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CO-CHI"
                    android:textColor="@color/cochi_text"
                    android:textSize="46sp"
                    android:textStyle="bold"
                    android:shadowColor="#AA19CFFF"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="9" />

                <TextView
                    android:id="@+id/welcomeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Cliente Demo"
                    android:textColor="@color/cochi_muted_strong"
                    android:textSize="17sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logoutButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginBottom="2dp"
                android:focusable="true"
                android:nextFocusDown="@id/cardTv1"
                android:nextFocusRight="@id/cardTv1"
                android:text="DESVINCULAR"
                android:textColor="@color/cochi_text"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@color/cochi_surface_2"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_cochi_unlink"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/cochi_accent_2"
                app:strokeColor="@color/cochi_accent"
                app:strokeWidth="2dp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/accountStatusCard"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/cochi_surface_2"
            app:cardCornerRadius="22dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/cochi_accent"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="Estado de cuenta"
                    android:src="@drawable/ic_cochi_shield" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/accountStatusTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CUENTA ACTIVA"
                        android:textColor="@color/cochi_accent_2"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:shadowColor="#8819CFFF"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="4" />

                    <TextView
                        android:id="@+id/accountStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="vence en 6 días"
                        android:textColor="@color/cochi_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardContinue"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:layout_marginTop="18dp"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusDown="@id/cardTv1"
            android:visibility="gone"
            app:cardBackgroundColor="@color/cochi_surface"
            app:cardCornerRadius="20dp"
            app:strokeColor="@color/cochi_accent"
            app:strokeWidth="2dp">

            <TextView
                android:id="@+id/continueLabel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="SEGUIR VIENDO"
                android:textColor="@color/cochi_text"
                android:textSize="18sp"
                android:textStyle="bold"
                android:shadowColor="#6619CFFF"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="3" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTv1"
                android:layout_width="0dp"
                android:layout_height="156dp"
                android:layout_marginEnd="7dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusRight="@id/cardTv2"
                android:nextFocusDown="@id/cardMovies"
                android:nextFocusUp="@id/cardContinue"
                app:cardBackgroundColor="@color/cochi_surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/cochi_accent"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:contentDescription="TV 1"
                        android:src="@drawable/ic_cochi_monitor" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="TV 1"
                        android:textColor="@color/cochi_text"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:shadowColor="#7719CFFF"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="4" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTv2"
                android:layout_width="0dp"
                android:layout_height="156dp"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusLeft="@id/cardTv1"
                android:nextFocusDown="@id/cardSeries"
                android:nextFocusUp="@id/cardContinue"
                app:cardBackgroundColor="@color/cochi_surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/cochi_accent"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:contentDescription="TV 2"
                        android:src="@drawable/ic_cochi_monitor" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="TV 2"
                        android:textColor="@color/cochi_text"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:shadowColor="#7719CFFF"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="4" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMovies"
                android:layout_width="0dp"
                android:layout_height="142dp"
                android:layout_marginEnd="7dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@id/cardTv1"
                android:nextFocusRight="@id/cardSeries"
                android:nextFocusDown="@id/cardAdult"
                app:cardBackgroundColor="@color/cochi_surface"
                app:cardCornerRadius="22dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/cochi_border"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:contentDescription="Películas"
                        android:src="@drawable/ic_cochi_movies" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="PELÍCULAS"
                        android:textColor="@color/cochi_text"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:shadowColor="#7719CFFF"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="4" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSeries"
                android:layout_width="0dp"
                android:layout_height="142dp"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@id/cardTv2"
                android:nextFocusLeft="@id/cardMovies"
                android:nextFocusDown="@id/cardAdult"
                app:cardBackgroundColor="@color/cochi_surface"
                app:cardCornerRadius="22dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/cochi_border"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:contentDescription="Series"
                        android:src="@drawable/ic_cochi_series" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="SERIES"
                        android:textColor="@color/cochi_text"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:shadowColor="#7719CFFF"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="4" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>



        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAdult"
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="20dp"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusUp="@id/cardSeries"
            app:cardBackgroundColor="@color/cochi_surface"
            app:cardCornerRadius="22dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/cochi_accent"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:contentDescription="Adultos"
                    android:src="@drawable/ic_cochi_lock" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="ADULTOS"
                    android:textColor="@color/cochi_text"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:shadowColor="#7719CFFF"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="4" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
